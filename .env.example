# Baymax — environment variables
# Copy this file to .env and fill in your credentials.
# Never commit .env.

# Pinecone vector database
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX_NAME=baymax-index  # optional, defaults to baymax-index

# Groq API (for the chat LLM)
GROQ_API_KEY=your-server-side-groq-key-here

# Server settings (optional)
HOST=0.0.0.0
PORT=8080
FLASK_DEBUG=1
